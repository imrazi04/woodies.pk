# Public address of the site. Used for canonical URLs, the sitemap, and link previews.
# In production set this to your real domain, e.g. https://woodiespk.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Copy to .env.local and fill in. Supabase — Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_ or import in client code.
SUPABASE_SECRET_KEY=your_supabase_secret_key
